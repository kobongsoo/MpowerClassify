# ============================================================================
# CSOClassify .gitignore
#  - 비밀/자격증명, 3rd-party 라이선스 바이너리, 대용량 모델·배포산출물,
#    실행 데이터·로그는 커밋하지 않는다(소스·문서·규칙셋만 공개).
# ============================================================================

# ---- 비밀 · 자격증명 (절대 커밋 금지) --------------------------------------
.env
.env.*
.env_*
**/.env
*.pem
*.key
*.pfx

# ---- 사이냅(3rd-party 라이선스 바이너리) · 대용량 임베딩 모델 --------------
/resources/synap/
/resources/models/

# ---- 빌드 산출물 · 배포본 (생성물 · 대용량) -------------------------------
/dist/
/dist-model/
/dist-onedir/
/dist-pkg/
# Rust 포팅판 배포본 — 모델(129MB)·onnxruntime·pdfium 및 zip/tgz 묶음(각 ~90MB).
# 빌드 방법은 doc/csoclassify-빌드가이드-rust.html 에 있으므로 산출물은 커밋하지 않는다.
/Rust/dist-onedir/
/Rust/target/
# build 폴더는 스펙 파일만 남기고 PyInstaller 작업 산출물은 제외
/build/*
!/build/*.spec

# ---- 실행 데이터 · 로그 (실데이터 · 생성물) -------------------------------
/log/
*.log
/ui/*.jsonl
/ui/*.json
/ui/*.csv
**/.ipynb_checkpoints/
cso_result.jsonl
class_seed.jsonl
class_seed_audit.jsonl
cso_override.jsonl
grades.jsonl

# ---- 파이썬 캐시 · 가상환경 -----------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/

# ---- 스크래치 · 임시 -------------------------------------------------------
/.txt
scratch*
*.tmp
*.bak
Thumbs.db
.DS_Store

# ---- 고객사 실데이터 (공개 저장소에 올리지 않는다) -------------------------
# 분류체계 스냅샷·원본 export·그 위에 쓴 규칙은 고객사 DB(DOC_CLASSIFICATION)에서
# 나온 값이라 제품 소스가 아니다. 형식은 *.sample.yaml 로 대신 문서화한다.
# 경로를 앞에 고정하지 않는다 — Rust 포팅판이 Rust/resources/policy/ 에 같은
# 파일을 하나 더 들고 있어서, 루트만 막으면 그쪽으로 그대로 새어 나간다.
**/resources/policy/doc_taxonomy.yaml
**/resources/policy/doc_classification_export.json
**/resources/policy/doc_classification_export_*.json
**/resources/policy/doc_rule.yaml
**/resources/policy/_old-*/
# 회사 겹 유의어 사전 — 고객 제품명·브랜드·회사명이 들어간다. 사람이 고치는 자리라
# 고객 정책 폴더(ui/policy·배포 폴더)에만 둔다. 제품 소스에 섞이면 공개 저장소로
# 나가고, 개발 환경의 엔진이 이 겹을 얹어 제품 기본 동작 측정이 흐려진다(2026-09-21).
**/doc_synonyms.local.yaml
# 회사별 업무분류 조정(분류별 말 더하기·빼기·설정). 고객 제품명·결정이 들어가는
# 고객 정책 파일이라 저장소에 두지 않는다(2026-09-22 규칙 자동 생성).
**/doc_rule.local.yaml
**/doc_rule.local.yaml.draft
# UI 가 실제로 읽고 쓰는 정책 폴더 — 실문서 경로·임베딩 벡터·승인자 이름이 들어간다.
# 추출 본문(--textsave) — 고객사 문서의 '내용'이 그대로 들어간다(개인정보 포함 가능).
# 공개 저장소이므로 폴더 이름을 바꿔 쓰더라도 걸리도록 두 갈래로 막는다.
/ui/_extracted/
_extracted/
/ui/policy/
/ui/policy_org/
/ui/settings.yaml
*.jsonl.bak*

# ---- 내부 업무 문서 --------------------------------------------------------
# 주간계획·개발일정·라벨링시트. 설계 HTML 은 기술문서라 남긴다.
/plan/*.xlsx

# ---- 편집 중 백업 · 에디터 설정 --------------------------------------------
*.bak
*.bak-*
*.bak_*
/.claude/

# ---- [2026-09-02] 저장소에 들어가면 안 되는 것 두 가지 ----------------------
# rustup 설치파일(12MB) — 3rd-party 설치 바이너리. 빌드가이드에 받는 방법이 있다.
/tools/
# `--log auto` 로 잘못 만들어진 로그 파일. 실 문서 경로가 들어 있어 공개 저장소에 두면 안 된다.
/src/auto

# ---- [2026-09-11] 공개 저장소에 나가면 안 되는 것 ---------------------------
# 편집 전 백업 꾸러미. 소스 스냅샷이라 .gitignore 로 막아 둔 파일까지 통째로
# 들어 있다 — tgz 로 묶이면 무시 규칙이 통하지 않는다(71MB).
/_backup/

# 리뷰·발표 자료. 고객사 이름과 실제 분류 대상 폴더 구조가 그대로 들어 있다.
# report/policy/*.txt 는 정책 파일을 확장자만 바꿔 담은 사본이라, 위쪽 정책
# 제외 규칙을 그대로 비껴간다.
/report/

# 평가셋(골든데이터셋). 고객사 실문서 경로 · 첫 줄 · 앞부분 발췌가 그대로 들어 있다.
# resources/ 는 커밋하는 폴더라 이 하위 폴더만 따로 막는다(2026-10-22 report/ 에서 옮김).
/resources/golden_dataset/

# 루트에 떨어진 실행 결과·목록. 실제 문서 경로와 검출 내역이 들어 있다.
/hr.jsonl
/rs_a.jsonl
/scratch_*.jsonl
/pdflist.txt

# 시험용 원본 문서. 출처가 분명치 않아 공개 저장소에 두지 않는다.
scripts/*.hwp

# ---- [2026-09-11] 빌드서버 설정 --------------------------------------------
# 서버 주소·계정·안쪽 경로는 코드가 아니라 설정이다. 저장소가 공개라
# 그대로 두면 내부 인프라가 노출된다. 보기 파일(server.env.sample)만 공개한다.
/scripts/build/server.env
/dist-ui/
